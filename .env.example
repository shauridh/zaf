# Supabase — salin ke .env.local dan isi sesuai proyek Anda
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Service role HANYA untuk server (jangan pernah prefix NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# JWT secret klasik (Dashboard > Settings > API > JWT Settings).
# Dipakai untuk mint token sesi staf/portal (HS256) agar RLS mengenali request.
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET

# App
NEXT_PUBLIC_APP_NAME=ChickenPOS
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Kurir on-demand (opsional — kosong = mode simulasi estimasi per-trip)
# Lalamove: https://developers.lalamove.com
LALAMOVE_API_KEY=
LALAMOVE_MARKETPLACE_ID=
# PandaGo (foodpanda): client ID + RSA private key
PANDAGO_CLIENT_ID=
PANDAGO_PRIVATE_KEY=
